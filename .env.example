# Copy to .env (Docker and next start) and/or .env.local (next dev).
# Placeholder values only; never commit real ones.

# Bearer token for /api/resume/*. Generate with: openssl rand -hex 32
# Unset means the API answers 503 (disabled).
RESUME_API_TOKEN=replace-with-64-hex-chars

# Private details for the private PDF only. They never reach the website.
# If either is unset, updates build only the public PDF.
RESUME_PHONE=000-000-0000
RESUME_ADDRESS=1 Example Street, City, Province

# SQLite file for résumé versions. Docker sets /data/resume.db.
# RESUME_DB=./data/resume.db

# SQLite file for content versions (site, home, about, projects, socials,
# posts). Defaults to content.db next to RESUME_DB. Docker sets /data/content.db.
# CONTENT_DB=./data/content.db

# Owner sign-in for /admin (edit the site in the browser). Create with:
#   npm run owner:hash-password
# and paste the printed line here. Leave empty to turn sign-in off; /admin
# then answers 404 for everyone.
OWNER_PASSWORD_HASH=
